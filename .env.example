# ── Logging Configuration ──
IDPS_LOG_DIR=/home/pi/idps/logs
EVE_LOG=/var/log/suricata/eve.json
BLOCKPAGE_DIR=/home/pi/idps/blockpage
ENV_FILE=/home/pi/idps/.env

# ── Network Configuration ──
GATEWAY_IP=192.168.50.1
LAN_IFACE=eth0
WAN_IFACE=wlan0
LAN_SUBNET=192.168.50.0/24

# ── IPv6 Configuration ──
IPV6_ENABLED=True
IPV6_WHITELIST_IPS=::1,fe80::/10

# ── Flask Dashboard ──
FLASK_HOST=0.0.0.0
FLASK_PORT=3000
ENABLE_AUTH=False
API_TOKEN=your-secret-api-token-here-change-in-production

# ── SSL/TLS Configuration ──
SSL_ENABLED=False
SSL_CERT_PATH=/home/pi/idps/logs/certs/cert.pem
SSL_KEY_PATH=/home/pi/idps/logs/certs/key.pem
SSL_HOSTNAME=localhost
SSL_AUTO_GENERATE=True
SSL_PROTOCOL=TLS

# ── Block Page Server ──
BLOCKPAGE_HOST=0.0.0.0
BLOCKPAGE_PORT=5001

# ── Alert Configuration ──
MAX_ALERTS=100
ALERT_STREAM_INTERVAL=0.5

# ── Decision Engine ──
AUTO_BLOCK_SEVERITY=2

# ── AbuseIPDB Threat Intelligence ──
ABUSEIPDB_API_KEY=your-api-key-here
ABUSEIPDB_CONFIDENCE=85
ABUSEIPDB_LIMIT=500

# ── Email Notifications ──
EMAIL_ENABLED=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=True
EMAIL_FROM=idps@example.com
EMAIL_TO=admin@example.com,security@example.com

# ── Telegram Notifications ──
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# ── IP Reputation Configuration ──
REPUTATION_ENABLED=True
REPUTATION_THRESHOLD=75
REPUTATION_CACHE_TTL=3600
AUTO_BLOCK_BY_REPUTATION=False

# ── Debug Mode ──
DEBUG=False
